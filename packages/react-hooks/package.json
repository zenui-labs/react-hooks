{
  "name": "@zenuilabs/react-hooks",
  "version": "2.0.0",
  "description": "Reusable, TypeScript-ready React hooks to supercharge your UI. Lightweight, fully typed, and built for seamless integration.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "hooks",
    "typescript",
    "utilities",
    "zenui-labs",
    "react-hooks",
    "reusable-hook"
  ],
  "author": "ZenUI Labs",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/zenui-labs/react-hooks"
  },
  "homepage": "https://react-hooks.zenui.net/",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}